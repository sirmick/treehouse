# Vagrant
.vagrant/
*.box

# Ansible
*.retry
# bin/up.sh generates ansible/inventory/libvirt with a per-host mgmt
# IP (not portable across machines). Other inventory files (e.g.
# libvirt-qemu, which is static) are committed.
ansible/inventory/libvirt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node / SvelteKit
node_modules/
launcher/.svelte-kit/

# Editor
.idea/
.vscode/
*.swp
*~

# Claude Code's per-project runtime state (scheduled-task locks, etc.)
.claude/

# Local secrets and state — never commit
config/secrets.yml
state/
logs/
content/
launcher/build/

# Per-deployment settings (LAN IPs, public domain). The template lives
# at treehouse.example.yml; copy and edit locally.
treehouse.yml

# Restic password files
*.restic-password

# OS
.DS_Store
