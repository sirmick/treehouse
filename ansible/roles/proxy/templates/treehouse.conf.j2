# nginx site config for the kids' segment.
# Bound to {{ kids_host_ip }}:80 only.
#
# In isolated mode dnsmasq sinkholes every unknown hostname to this IP
# so the default_server catches youtube.com / tiktok.com / etc. In lan
# mode unknown Hosts mostly come from misconfigured proxies or probes,
# but the default_server handles them the same way.
#
# Each named vhost takes both its internal name (home.kids, etc.) AND
# the configured public alias from treehouse.yml's hostnames: table —
# so requests like `Host: home-kids.<your-domain>` hit the same backend.
# (Public domain is per-deployment; treehouse.yml is gitignored, with
# treehouse.example.yml as the committed template.)
#
# Backends (kiwix, meilisearch) publish on the VM's loopback via the
# compose port mappings. Host nginx forwards directly — no compose
# proxy in between.

# Default server — sinkhole for any unrecognised Host header.
server {
    listen {{ kids_host_ip }}:80 default_server;
    server_name _;
    root {{ treehouse_root }}/launcher;

    location / {
        try_files /sinkhole.html =404;
    }
}

# home.kids — launcher static site + /api/search proxy to MeiliSearch.
server {
    listen {{ kids_host_ip }}:80;
    server_name home.kids hello.kids
                {{ hostnames.home.public }} {{ hostnames.hello.public }};
    root {{ treehouse_root }}/launcher;
    index index.html;

    # /api/search → MeiliSearch directly. The browser POSTs JSON; nginx
    # rewrites the path to MeiliSearch's index-search endpoint.
    location = /api/search {
        proxy_pass http://127.0.0.1:7700/indexes/treehouse/search;
        proxy_http_version 1.1;
    }

    # adapter-static produces flat .html files (search.html etc.);
    # $uri.html is the second fallback so /search resolves correctly.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}

# wikipedia.kids — forward straight to the kiwix container on
# 127.0.0.1:8080. Multiple kiwix books (Wikipedia, Wiktionary, Vikidia)
# are all served from the same container under /content/<book>/...
# paths; the launcher's search results build URLs against this vhost.
server {
    listen {{ kids_host_ip }}:80;
    server_name wikipedia.kids {{ hostnames.wikipedia.public }};

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Kiwix can be slow on first ZIM read; tolerate it.
        proxy_read_timeout 60s;
    }
}
