# nginx site config for the kids' segment.
# Bound to {{ kids_host_ip }}:80 only. dnsmasq sinkholes every
# unknown hostname to this IP, so the default_server block catches
# unrecognised hosts with the friendly "not at home" page.

# Default server — sinkhole for any unrecognised Host header.
server {
    listen {{ kids_host_ip }}:80 default_server;
    server_name _;
    root {{ treehouse_root }}/launcher;

    location / {
        try_files /sinkhole.html =404;
    }
}

# home.kids — placeholder landing page.
server {
    listen {{ kids_host_ip }}:80;
    server_name home.kids hello.kids;
    root {{ treehouse_root }}/launcher;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# wikipedia.kids — reverse proxy to the kiwix container on host:8080.
server {
    listen {{ kids_host_ip }}:80;
    server_name wikipedia.kids;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
