# nginx site config for the kids' segment.
# Bound to {{ kids_host_ip }}:80 only.
#
# Generated from `hostnames:` in treehouse.yml — every entry there
# becomes a server block here. To add a new top-level app: add one
# entry, re-run `make provision`. No edits to this template needed
# for ordinary additions.
#
# In isolated mode dnsmasq sinkholes every unknown hostname to this IP
# so the default_server below catches youtube.com / tiktok.com / etc.
# In lan mode unknown Hosts mostly come from misconfigured proxies or
# probes; the default_server handles them the same way.
#
# Backends (kiwix, meilisearch) publish on the VM's loopback via the
# compose port mappings. Host nginx forwards directly — no compose
# proxy in between.

# Default server — sinkhole for any unrecognised Host header.
server {
    listen {{ kids_host_ip }}:80 default_server;
    server_name _;
    root {{ treehouse_root }}/launcher;

    location / {
        try_files /sinkhole.html =404;
    }
}

{% for h_id, h in hostnames.items() %}
{% if h.serves == 'launcher' %}
# {{ h_id }} — launcher static site{% if h.landing is defined %} (lands at {{ h.landing }}){% endif %}

server {
    listen {{ kids_host_ip }}:80;
    server_name {{ h.internal }} {{ h.public }};
    root {{ treehouse_root }}/launcher;
    index index.html;

    # /api/search → MeiliSearch directly. The browser POSTs JSON; nginx
    # rewrites the path to MeiliSearch's index-search endpoint.
    location = /api/search {
        proxy_pass http://127.0.0.1:7700/indexes/treehouse/search;
        proxy_http_version 1.1;
    }

{% if h.landing is defined %}
    # Land users at {{ h.landing }} when they hit the bare hostname.
    location = / {
        return 302 {{ h.landing }};
    }

{% endif %}
    # adapter-static produces flat .html files (search.html etc.);
    # $uri.html is the second fallback so /search resolves correctly.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}

{% elif h.serves == 'kiwix' %}
{% set z = (zims | selectattr('source', 'equalto', h.book) | list | first) %}
{% set book_path = '/content/' ~ z.catalog ~ '_' ~ z.version ~ '/' %}
# {{ h_id }} — kiwix book "{{ h.book }}" ({{ z.catalog }})

server {
    listen {{ kids_host_ip }}:80;
    server_name {{ h.internal }} {{ h.public }};

    # Land users on this book's content when they hit the bare hostname.
    # The /content/<zim>/ path is the kiwix-stable per-book entry; the
    # zim version moves only when group_vars `zims` updates.
    location = / {
        return 302 {{ book_path }};
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Kiwix can be slow on first ZIM read; tolerate it.
        proxy_read_timeout 60s;
    }
}

{% endif %}
{% endfor %}
