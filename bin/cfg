#!/usr/bin/env bash
# Read a value from a YAML config file by dotted path. Trivial helper
# for shell consumers (bin/up.sh, Makefile guards, bin/test-live.sh,
# seed-wikipedia) so we don't sprinkle inline python yaml-loaders
# everywhere.
#
# Usage:
#   cfg network.mode                       # treehouse.yml → isolated
#   cfg network.lan.dns                    # space-joined for lists
#   cfg hostnames.wikipedia.public         # → wiki-kids.example.com
#   cfg -f manifest.yml zims.0.name        # → wikipedia_en_100_maxi
#
# Default file is treehouse.yml at repo root. Override with -f or via
# the TREEHOUSE_CONFIG env var. Exits 1 on missing key. Requires
# python3 + pyyaml (transitive dep of ansible).

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="${TREEHOUSE_CONFIG:-$REPO_ROOT/treehouse.yml}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--file)
      CONFIG="$2"
      # Resolve to repo root if relative.
      [[ "$CONFIG" = /* ]] || CONFIG="$REPO_ROOT/$CONFIG"
      shift 2
      ;;
    -h|--help)
      sed -n '2,15p' "$0" | sed 's/^# //'
      exit 0
      ;;
    -*)
      echo "unknown flag: $1" >&2
      exit 2
      ;;
    *)
      DOTTED="$1"
      shift
      ;;
  esac
done

if [[ -z "${DOTTED:-}" ]]; then
  echo "usage: $(basename "$0") [-f file] <dotted.path>" >&2
  exit 2
fi

[[ -f "$CONFIG" ]] || { echo "config not found: $CONFIG" >&2; exit 1; }

python3 - "$CONFIG" "$DOTTED" <<'PY'
import sys, yaml
config_path, dotted = sys.argv[1], sys.argv[2]
with open(config_path) as f:
    data = yaml.safe_load(f)
for part in dotted.split('.'):
    if isinstance(data, list):
        try:
            data = data[int(part)]
        except (ValueError, IndexError):
            sys.stderr.write(f"key not found: {dotted}\n")
            sys.exit(1)
    elif isinstance(data, dict) and part in data:
        data = data[part]
    else:
        sys.stderr.write(f"key not found: {dotted}\n")
        sys.exit(1)
if isinstance(data, list):
    print(' '.join(str(x) for x in data))
elif isinstance(data, dict):
    sys.stderr.write(f"key resolves to dict, not scalar: {dotted}\n")
    sys.exit(1)
else:
    print(data)
PY
